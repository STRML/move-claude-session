#!/usr/bin/env python3
"""move-claude-session — move a Claude Code session to another account.

Each account keeps its sessions under its own config dir, found by looking for a
`projects/` folder:

    default   ~/.claude           (CLAUDE_CONFIG_DIR unset)
    <name>    ~/.claude-<name>    (CLAUDE_CONFIG_DIR=~/.claude-<name>)

This tool finds a session in whichever account holds it and moves it to the target
account, under the same project folder, so `claude --resume <id>` with that account's
CLAUDE_CONFIG_DIR finds it.

Usage:
    move-claude-session                     pick a session, pick an account, move, resume
    move-claude-session <session_id> <account>
    move-claude-session <session_id> <account>@<host>

With no arguments it opens a picker with three sections, newest first in each:

    in this terminal   sessions that ran in this terminal pane (from cmux's hook log)
    in this folder     sessions whose project is the current directory
    all sessions       the most recent sessions in every account

The account step preselects the account you moved to last, and is skipped when only
one other account exists.

Other machines: list ssh aliases, one per line, in
~/.config/move-claude-session/hosts (or set MOVE_CLAUDE_SESSION_HOSTS="a b"). The
picker then asks which machine before the account, starting on the last one used,
and lists that machine's accounts over ssh. With no hosts there is no machine step.

Type to filter, arrows to move, Enter to pick, Esc to cancel. After the move it runs
`claude --resume <id>` under the new account, from the session's project directory.
On another machine it does that in a `cmux ssh` workspace, or with `ssh -t` outside
cmux, and only when the project directory exists there.

Options:
    -n, --dry-run   Show what would happen; change nothing.
    --force         Overwrite existing files at the destination, move a session that
                    is still running, and on another machine stash uncommitted changes
                    in the checkout there instead of refusing.
    --no-code       On another machine, move the session but not its git checkout.
    --list          Print the picker's rows, with their section, and exit.
    -h, --help      This help.

A session counts as running while `claude agents --json` lists it for its account.
Needs `claude` on PATH.

What it moves (paths relative to the account's config dir):
    projects/<proj>/<session_id>.jsonl    transcript
    projects/<proj>/<session_id>/         subagents, tool-results
    projects/<proj>/cship/<session_id>-*  cship caches
    <dir>/*<session_id>*                  per-session entries in every other top-level
                                          dir (file-history, tasks, session-env, ...)

The transcript and subagent transcripts have each moved path rewritten to its new
location, so persisted tool output still resolves. Nothing else is rewritten.

On another machine the session's git checkout goes too, at the same absolute path:
the commits the host lacks, HEAD on the same branch, and the working tree's
modified, deleted and untracked (not ignored) files. The repo here is only read.
"""

import functools
import hashlib
import io
import json
import mmap
import os
import re
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
from concurrent.futures import ThreadPoolExecutor

DEFAULT_ACCOUNT = "default"
LOCAL = "local"   # the machine step's name for this machine
CMUX_HOOK_SESSIONS = "~/.cmuxterm/claude-hook-sessions.json"
# Picker sections: (title, how many of the newest sessions it shows).
GROUPS = (("in this terminal", 10), ("in this folder", 20), ("all sessions", 40))
PROMPT_SCAN_BYTES = 256 * 1024   # where to look for the first prompt


def die(msg: str) -> "NoReturn":
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


@functools.lru_cache(maxsize=None)
def accounts():
    """{name: config dir} for every Claude Code config dir that holds projects."""
    home = os.path.expanduser("~")
    found = {}
    if os.path.isdir(os.path.join(home, ".claude", "projects")):
        found[DEFAULT_ACCOUNT] = os.path.join(home, ".claude")
    for entry in sorted(os.listdir(home)):
        path = os.path.join(home, entry)
        if entry.startswith(".claude-") and os.path.isdir(os.path.join(path, "projects")):
            found[entry[len(".claude-"):]] = path
    return found


def account_root(name: str) -> str:
    return accounts()[name]


def launch_env(account: str):
    """The environment that makes plain `claude` use this account."""
    env = dict(os.environ)
    env.pop("CLAUDE_CONFIG_DIR", None)   # unset means ~/.claude
    if account != DEFAULT_ACCOUNT:
        env["CLAUDE_CONFIG_DIR"] = account_root(account)
    return env


def resume_command(account: str, session_id: str) -> str:
    prefix = ("" if account == DEFAULT_ACCOUNT
              else f"CLAUDE_CONFIG_DIR={shlex.quote(account_root(account))} ")
    return f"{prefix}claude --resume {session_id}"


# ---------------------------------------------------------------- session lookup

def find_transcripts(session_id: str):
    """Every (account, transcript path) holding this session."""
    hits = []
    for name in accounts():
        projects = os.path.join(account_root(name), "projects")
        if not os.path.isdir(projects):
            continue
        for proj in os.listdir(projects):
            cand = os.path.join(projects, proj, f"{session_id}.jsonl")
            if os.path.isfile(cand):
                hits.append((name, cand))
    return hits


def all_transcripts():
    """(account, session_id, path, mtime) for every top-level transcript."""
    out = []
    for name in accounts():
        projects = os.path.join(account_root(name), "projects")
        if not os.path.isdir(projects):
            continue
        for proj in os.scandir(projects):
            if not proj.is_dir(follow_symlinks=False):
                continue
            try:
                entries = list(os.scandir(proj.path))
            except OSError:
                continue
            for e in entries:
                if e.name.endswith(".jsonl") and e.is_file(follow_symlinks=False):
                    out.append((name, e.name[:-6], e.path, e.stat().st_mtime))
    return out


def agents_json(account: str):
    """Live sessions of one account, from `claude agents --json` (documented in the
    agent view docs). Raises RuntimeError when it can't be read."""
    try:
        out = subprocess.run(["claude", "agents", "--json"], env=launch_env(account),
                             capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.SubprocessError) as e:
        raise RuntimeError(f"{account}: {e}") from e
    if out.returncode != 0:
        raise RuntimeError(f"{account}: {out.stderr.strip() or f'exit {out.returncode}'}")
    try:
        rows = json.loads(out.stdout)
    except ValueError as e:
        raise RuntimeError(f"{account}: unreadable output ({e})") from e
    return [r for r in rows if isinstance(r, dict)] if isinstance(rows, list) else []


def running_sessions(force: bool = False):
    """{session_id: pid} for every live session in every account, asked of all
    accounts at once. With force, skip the check."""
    if force:
        return {}
    try:
        with ThreadPoolExecutor() as pool:
            found = list(pool.map(agents_json, accounts()))
    except RuntimeError as e:
        die(f"can't tell which sessions are running ({e}). "
            "Quit the session and pass --force to skip this check.")
    # pid and status are present only while the process is alive.
    return {r.get("sessionId"): r.get("pid") for rows in found for r in rows
            if r.get("pid") or r.get("status")}


# ---------------------------------------------------------------- the move itself

def plan_moves(session_id: str, src_root: str, dst_root: str, proj: str):
    """(src, dst) pairs for every file or dir that belongs to the session."""
    rel = [os.path.join("projects", proj, f"{session_id}.jsonl")]
    proj_dir = os.path.join(src_root, "projects", proj)
    if os.path.isdir(os.path.join(proj_dir, session_id)):
        rel.append(os.path.join("projects", proj, session_id))
    cship = os.path.join(proj_dir, "cship")
    if os.path.isdir(cship):
        rel += [os.path.join("projects", proj, "cship", f)
                for f in sorted(os.listdir(cship)) if f.startswith(session_id + "-")]
    for top in sorted(os.listdir(src_root)):
        top_dir = os.path.join(src_root, top)
        if top == "projects" or os.path.islink(top_dir) or not os.path.isdir(top_dir):
            continue
        try:
            names = sorted(os.listdir(top_dir))
        except PermissionError:
            print(f"warning: cannot read {top_dir}, skipped", file=sys.stderr)
            continue
        rel += [os.path.join(top, f) for f in names if session_id in f]
    return [(os.path.join(src_root, r), os.path.join(dst_root, r)) for r in rel]


def rewritten(data: bytes, moves) -> bytes:
    """Transcript bytes with every moved path pointed at its new location. Works on
    bytes, so a transcript with invalid UTF-8 keeps every byte."""
    for src, dst in moves:
        data = data.replace(os.fsencode(src), os.fsencode(dst))
    return data


def rewrite_paths(path: str, moves) -> None:
    with open(path, "rb") as fh:
        data = fh.read()
    with open(path, "wb") as fh:
        fh.write(rewritten(data, moves))


def resume_dir(jsonl_path: str, proj: str) -> str:
    """The cwd that names the project folder, which is where --resume looks.

    A session that entered a worktree records later cwds that no longer match it,
    so fall back to the last cwd only when none does.
    """
    last = "."
    with open(jsonl_path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                cwd = json.loads(line).get("cwd")
            except (json.JSONDecodeError, AttributeError):
                continue
            if not cwd:
                continue
            if folder_matches(proj, cwd):
                return cwd
            last = cwd
    return last


def transcripts_under(path: str):
    if os.path.isfile(path):
        return [path] if path.endswith(".jsonl") else []
    return [os.path.join(d, f) for d, _, files in os.walk(path)
            for f in files if f.endswith(".jsonl")]


def remove(path: str) -> None:
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    elif os.path.lexists(path):
        os.remove(path)


def copy_item(src: str, dst: str) -> None:
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if os.path.isdir(src) and not os.path.islink(src):
        shutil.copytree(src, dst, symlinks=True)
    else:
        shutil.copy2(src, dst, follow_symlinks=False)


def transfer(moves, force: bool) -> None:
    """Copy every item, rewrite paths in the copies, then delete the sources.
    A failure before the delete removes the copies and leaves the source whole."""
    clashes = [dst for _, dst in moves if os.path.lexists(dst)]
    if clashes and not force:
        die(f"destination already exists: {clashes[0]} (use --force to overwrite)")
    copied = []
    try:
        for src, dst in moves:
            remove(dst)
            copied.append(dst)
            copy_item(src, dst)
        for dst in copied:
            for path in transcripts_under(dst):
                rewrite_paths(path, moves)
    except BaseException as e:   # any failure, Ctrl-C included, rolls back the copies
        for dst in copied:
            try:
                remove(dst)
            except OSError:
                pass
        if not isinstance(e, Exception):
            raise
        die(f"move failed, nothing changed: {e}")
    delete_sources(moves)


def delete_sources(moves) -> None:
    """Delete the originals once their copies are in place."""
    leftovers = []
    for src, _ in moves:
        try:
            remove(src)
        except OSError:
            leftovers.append(src)
    if leftovers:
        print("warning: moved, but could not delete these originals. Delete them by hand,\n"
              "or the session will be found in two accounts:\n  " + "\n  ".join(leftovers),
              file=sys.stderr)


def move_session(session_id: str, target: str, dry: bool, force: bool, dest=None,
                 carry: bool = True):
    """Move the session to `target`, or to the remote account `dest` when given.
    Returns the directory to resume from (with, for a remote, whether it exists
    there), or None on a dry run."""
    hits = find_transcripts(session_id)
    if not hits:
        die(f"no transcript for session {session_id} in any account")
    if len(hits) > 1:
        die("session found in more than one place:\n  "
            + "\n  ".join(f"{n}: {p}" for n, p in hits))
    source, src_jsonl = hits[0]
    if dest is None and source == target:
        die(f"session already lives in {target}: {src_jsonl}")

    pid = running_sessions(force).get(session_id)
    if pid:
        die(f"session is still running (pid {pid}). Quit it first, or pass --force.")

    proj = os.path.basename(os.path.dirname(src_jsonl))
    if dest is not None:
        return move_remote(session_id, source, src_jsonl, proj, dest, dry, force, carry)
    moves = plan_moves(session_id, account_root(source), account_root(target), proj)

    if dry:
        print(f"would move {session_id} from {source} ({account_root(source)})"
              f" to {target} ({account_root(target)}):")
        for src, _ in moves:
            print(f"  {os.path.relpath(src, account_root(source))}")
        print("\n(dry run, nothing changed)")
        return None

    title = read_label(src_jsonl)[1] or session_id
    transfer(moves, force)
    save_last(target, LOCAL)
    print(f"moved {title}: {source} → {target} ({len(moves)} items)")
    return resume_dir(moves[0][1], proj)


# ---------------------------------------------------------------- other machines
#
# A remote move runs four ssh calls, each a POSIX sh script that reports on
# stdout through MCS- lines (ssh_config can print noise on stderr even when a
# call succeeds): find the accounts, check the destination, upload into a staging
# dir beside them, then verify and move into place. Local files are deleted only
# after the last call reports MCS-COMMITTED.

SSH_OPTS = ("-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
            "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=4")
HOST_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._@-]*\Z")
ACCOUNT_RE = re.compile(r"[A-Za-z0-9._-]+\Z")

DISCOVER = r"""cd || exit 1
printf 'MCS-HOME %s\n' "$PWD"
for d in .claude .claude-*; do
  [ -d "$d" ] || continue
  [ -d "$d/projects" ] || [ -e "$d/.claude.json" ] || [ -e "$d/settings.json" ] || continue
  if [ -d "$d/projects" ]; then p=1; else p=0; fi
  printf 'MCS-ACCOUNT %s %s\n' "$p" "$d"
done"""

PREFLIGHT = r"""root=$1 dir=$2; shift 2
printf 'MCS-ROOT %s %s\n' "$(ls -di "$root" | awk '{print $1}')" "$(cd "$root" && pwd -P)"
for rel; do
  if [ -e "$root/$rel" ] || [ -L "$root/$rel" ]; then printf 'MCS-EXISTS %s\n' "$rel"; fi
done
if [ -d "$dir" ]; then echo MCS-DIR yes; else echo MCS-DIR no; fi
echo MCS-OK"""

UPLOAD = r"""rm -rf "$1" && mkdir -p "$1" && cd "$1" && tar -xpf - && echo MCS-UPLOADED"""

CLEANUP = r"""rm -rf "$1" && echo MCS-CLEAN"""

# stdin: "<sha256>  <path>" for every file. Each hash is taken from stdin, so the
# output shape of GNU sha256sum, BSD sha256sum and shasum is the same. The count
# is checked too: a list cut short would otherwise pass on the lines that arrived.
# It ignores HUP and PIPE, so a dropped connection can't stop it halfway: it either
# finishes or rolls back. Items it replaces (--force) wait in $stage.old until the
# rest are in place, and go back if any move fails.
COMMIT = r"""root=$1 stage=$2 force=$3 dir=$4 files=$5; shift 5
trap '' HUP PIPE
old="$stage.old"
if [ -e "$old" ] || [ -L "$old" ]; then
  rm -rf "$stage"
  printf 'MCS-STUCK an earlier failed move left the files it replaced in %s; put them back or delete them, then try again\n' "$old"
  exit 1
fi
fail() { cd / && rm -rf "$stage" "$old"; printf 'MCS-FAIL %s\n' "$1"; exit 1; }
cd "$stage" || fail "the uploaded copy is gone"
if command -v shasum >/dev/null 2>&1; then sum="shasum -a 256"
elif command -v sha256sum >/dev/null 2>&1; then sum=sha256sum
else fail "no shasum or sha256sum to check the copy with"; fi
n=0
while read -r want rel; do
  got=$($sum < "$rel" | cut -c1-64) && [ "$got" = "$want" ] || fail "$rel did not arrive intact"
  n=$((n + 1))
done
[ "$n" = "$files" ] || fail "the file list did not arrive whole"
for rel; do
  if [ "$force" != 1 ] && { [ -e "$root/$rel" ] || [ -L "$root/$rel" ]; }; then
    fail "$root/$rel already exists"
  fi
done
there() { [ -e "$1" ] || [ -L "$1" ]; }
n=0
for rel; do
  if mkdir -p "$(dirname "$root/$rel")" "$(dirname "$old/$rel")" &&
     { ! there "$root/$rel" || mv "$root/$rel" "$old/$rel"; } &&
     mv "$stage/$rel" "$root/$rel"
  then n=$((n + 1)); continue; fi
  i=0 stuck=""
  for back; do
    [ "$i" -le "$n" ] || break
    if [ "$i" -lt "$n" ]; then rm -rf "$root/$back" || stuck=1; fi
    if there "$old/$back"; then
      if there "$root/$back"; then stuck=1; else mv "$old/$back" "$root/$back" || stuck=1; fi
    fi
    i=$((i + 1))
  done
  if [ -n "$stuck" ]; then
    printf 'MCS-STUCK could not move %s into place, and could not undo it all: what it replaced is kept in %s\n' "$rel" "$old"
    exit 1
  fi
  fail "could not move $rel into place"
done
cd / && rm -rf "$stage" "$old"
if [ -d "$dir" ]; then echo MCS-DIR yes; else echo MCS-DIR no; fi
echo MCS-COMMITTED"""


def check_host(host: str) -> str:
    if not HOST_RE.match(host):
        die(f"not an ssh host alias: {host!r}")
    return host


def configured_hosts():
    """ssh destinations to offer on the machine step: $MOVE_CLAUDE_SESSION_HOSTS
    when set (space or comma separated), else one per line in the hosts file."""
    words = os.environ.get("MOVE_CLAUDE_SESSION_HOSTS")
    if words is None:
        try:
            with open(hosts_path(), encoding="utf-8") as fh:
                words = "\n".join(line.split("#", 1)[0] for line in fh)
        except OSError:
            return []
    hosts = []
    for host in words.replace(",", " ").split():
        if not HOST_RE.match(host):
            print(f"warning: skipped {host!r} in the hosts list, not an ssh host alias",
                  file=sys.stderr)
        elif host != LOCAL and host not in hosts:
            hosts.append(host)
    return hosts


def hosts_path() -> str:
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(base, "move-claude-session", "hosts")


def ssh_error(stderr: str) -> str:
    """The line that says why ssh failed, skipping ssh_config noise."""
    lines = [ln.strip() for ln in stderr.splitlines() if ln.strip()]
    known = [ln for ln in lines if ln.startswith("ssh:") or re.search(
        r"Connection|Permission denied|[Hh]ost key|timed out", ln)]
    return (known or lines or ["no error output"])[-1]


def ssh_run(host: str, script: str, args=(), feed=None, timeout=60):
    """Run a sh script on host with these arguments; `feed(stdin)` writes its input.
    Returns (exit code, stdout lines, the error line from stderr)."""
    for a in args:
        if "\\" in a or "\n" in a:   # fish reads backslashes in single quotes
            die(f"can't pass this path over ssh: {a!r}")
    remote = " ".join(["sh", "-c", shlex.quote(script), "sh", *map(shlex.quote, args)])
    argv = ["ssh", *SSH_OPTS, "--", host, remote]
    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        try:
            proc = subprocess.Popen(argv, stdin=subprocess.PIPE if feed else subprocess.DEVNULL,
                                    stdout=out, stderr=err)
        except OSError as e:
            return 255, [], f"ssh: {e}"
        try:
            if feed:
                feed(proc.stdin)
                proc.stdin.close()
        except BrokenPipeError:
            pass   # the far end went away; its exit code says how
        except BaseException:
            proc.kill()
            proc.wait()
            raise
        try:
            code = proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
            return 255, [], f"ssh: no answer from {host} in {timeout} s"
        out.seek(0)
        err.seek(0)
        return (code, out.read().decode(errors="replace").splitlines(),
                ssh_error(err.read().decode(errors="replace")))


@functools.lru_cache(maxsize=None)
def remote_accounts(host: str):
    """(home, {name: (config dir, has projects/)}) on host. A config dir without
    projects/ is an account that has not run a session yet."""
    code, lines, err = ssh_run(host, DISCOVER)
    home = next((ln[len("MCS-HOME "):] for ln in lines if ln.startswith("MCS-HOME ")), None)
    if code != 0 or home is None:
        die(f"can't reach {host}: {err}. Nothing changed.")
    found = {}
    for ln in lines:
        if not ln.startswith("MCS-ACCOUNT "):
            continue
        flag, d = ln[len("MCS-ACCOUNT "):].split(" ", 1)
        name = DEFAULT_ACCOUNT if d == ".claude" else d[len(".claude-"):]
        if ACCOUNT_RE.match(name) and name not in found:   # ~/.claude wins "default"
            found[name] = (f"{home}/{d}", flag == "1")
    if not found:
        die(f"no Claude Code config dir on {host} (looked for ~/.claude and ~/.claude-*)")
    return home, found


def remote_dest(host: str, account: str):
    """(host, account, config dir) for an account on host, or die naming the ones
    it has."""
    found = remote_accounts(host)[1]
    if account not in found:
        die(f"no account {account} on {host} (one of {', '.join(found)})")
    return host, account, found[account][0]


def pack(moves, src_root: str, fh, sums) -> None:
    """Write the session to fh as a tar stream, paths relative to the config dir,
    transcripts rewritten, adding a sha256 line to sums for every regular file."""
    with tarfile.open(fileobj=fh, mode="w|", format=tarfile.PAX_FORMAT) as tar:
        for src, _ in moves:
            for path in [src] + sorted(walk_tree(src)):
                arc = os.path.relpath(path, src_root)
                info = tar.gettarinfo(path, arc)
                if info is None:   # a socket or other special file
                    continue
                if not info.isfile():
                    tar.addfile(info)
                    continue
                with open(path, "rb") as f:
                    data = f.read()
                if path.endswith(".jsonl"):
                    data = rewritten(data, moves)
                info.size = len(data)
                tar.addfile(info, io.BytesIO(data))
                sums.append(f"{hashlib.sha256(data).hexdigest()}  {arc}\n")


def walk_tree(path: str):
    """Everything under a directory, symlinks included but not followed."""
    if os.path.islink(path) or not os.path.isdir(path):
        return []
    def unreadable(e):
        raise e
    return [os.path.join(d, n) for d, dirs, files in os.walk(path, onerror=unreadable)
            for n in dirs + files]


def move_remote(session_id, source, src_jsonl, proj, dest, dry, force, carry=True):
    cwd = resume_dir(src_jsonl, proj)
    with tempfile.TemporaryDirectory(prefix="move-claude-session-") as scratch:
        checkout = local_checkout(cwd, scratch) if carry else None
        try:
            return move_remote_with(session_id, source, src_jsonl, proj, dest, dry, force,
                                    cwd, checkout)
        except GitError as e:
            die(f"git failed here: {e}. Nothing was deleted here.")


def move_remote_with(session_id, source, src_jsonl, proj, dest, dry, force, cwd, checkout):
    host, account, root = dest
    src_root = account_root(source)
    moves = plan_moves(session_id, src_root, root, proj)
    rels = [os.path.relpath(src, src_root) for src, _ in moves]
    code, lines, err = ssh_run(host, PREFLIGHT, [root, cwd, *rels])
    if code != 0 or "MCS-OK" not in lines:
        die(f"can't check {host}: {err}. Nothing changed.")
    if remote_is_here(lines, src_root):
        die(f"{host} is this machine: {root} is the account the session is in. Nothing changed.")
    clashes = [ln[len("MCS-EXISTS "):] for ln in lines if ln.startswith("MCS-EXISTS ")]
    dir_ok = "MCS-DIR yes" in lines
    plan = plan_code(host, checkout, force) if checkout else None

    if dry:
        print(f"would move {session_id} from {source} ({src_root})"
              f" to {account} on {host} ({root}):")
        for rel in rels:
            print(f"  {rel}{'   (already there)' if rel in clashes else ''}")
        if plan:
            print_code_plan(host, checkout, plan)
        elif not dir_ok:
            print(f"\n{cwd} does not exist on {host}.")
        print("\n(dry run, nothing changed)")
        return None
    if clashes and not force:
        die(f"destination already exists on {host}: {root}/{clashes[0]} (use --force to overwrite)")

    if plan:
        carry_code(host, checkout, plan, session_id)
    title = read_label(src_jsonl)[1] or session_id
    before = {src: os.lstat(src).st_ino for src, _ in moves}
    stage = f"{root}/.move-claude-session-{session_id}.partial"
    sums = []
    try:
        code, lines, err = ssh_run(host, UPLOAD, [stage], timeout=None,
                                   feed=lambda fh: pack(moves, src_root, fh, sums))
        listing = os.fsencode("".join(sums))
    except (Exception, KeyboardInterrupt) as e:   # a local file that can't be read, Ctrl-C
        code, lines, err = 1, [], str(e) or type(e).__name__
    if code != 0 or "MCS-UPLOADED" not in lines:
        if "MCS-CLEAN" in ssh_run(host, CLEANUP, [stage])[1]:
            die(f"copy to {host} failed, nothing changed: {err}")
        die(f"copy to {host} failed: {err}. The session is untouched here. A partial "
            f"copy may be left in {host}:{stage}; the next try replaces it.")
    try:
        code, lines, err = ssh_run(host, COMMIT, [root, stage, "1" if force else "0", cwd,
                                                  str(len(sums)), *rels],
                                   feed=lambda fh: fh.write(listing), timeout=600)
    except KeyboardInterrupt:
        lines, err = [], "interrupted"
    if "MCS-COMMITTED" not in lines:
        failed = next((ln[len("MCS-FAIL "):] for ln in lines if ln.startswith("MCS-FAIL ")), None)
        if failed:
            die(f"move to {host} failed, nothing changed: {failed}")
        stuck = next((ln[len("MCS-STUCK "):] for ln in lines if ln.startswith("MCS-STUCK ")), None)
        if stuck:
            die(f"move to {host} failed: {stuck}. Nothing was deleted here.")
        die(f"could not confirm the move on {host} ({err}). Nothing was deleted here. "
            f"On {host} the move either finished or rolled itself back: run the same "
            f"move again. If it stops with 'destination already exists', the session "
            f"is in {root} on {host} and this copy can go.")
    # A source that changed under us means the host was this machine after all.
    replaced = [src for src, _ in moves if not same_inode(src, before[src])]
    if replaced:
        die(f"the move wrote over the originals here, so {host} looks like this machine. "
            f"Nothing was deleted:\n  " + "\n  ".join(replaced))
    delete_sources(moves)
    save_last(account, host)
    print(f"moved {title}: {source} → {account}@{host} ({len(moves)} items)")
    return cwd, "MCS-DIR yes" in lines


# ---------------------------------------------------------------- the code
#
# A remote move carries the session's git checkout too, as `cmux session move`
# does: HEAD on the same branch, then the working tree's changes laid over it.
# The repo here is only read. Its working tree is snapshotted as a commit made with
# a temporary index into a scratch object store whose alternates point at the
# repo's objects, so nothing is written to the repo. A bundle of that commit, less
# what the host's refs already hold, goes over ssh, and the host fetches it, checks
# out HEAD and restores the snapshot over the working tree.

GIT_SCRUB = ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
             "GIT_ALTERNATE_OBJECT_DIRECTORIES", "GIT_COMMON_DIR", "GIT_PREFIX")
# Options for commands that write the temporary index: no split index or fsmonitor,
# which would put files in the repo's git dir.
SNAPSHOT_OPTS = ("-c", "core.splitIndex=false", "-c", "core.fsmonitor=false",
                 "-c", "core.untrackedCache=false")
SNAPSHOT_IDENT = {f"GIT_{who}_{what}": value for who in ("AUTHOR", "COMMITTER")
                  for what, value in (("NAME", "move-claude-session"),
                                      ("EMAIL", "move-claude-session@localhost"))}


class GitError(Exception):
    pass


def git(args, cwd=None, env=None, input=None, check=True) -> str:
    """Run git here and return its stdout. Never takes optional locks, so a read
    doesn't refresh the repo's index."""
    full = {k: v for k, v in os.environ.items() if k not in GIT_SCRUB}
    full["GIT_OPTIONAL_LOCKS"] = "0"
    full.update(env or {})
    try:
        r = subprocess.run(["git", *args], cwd=cwd, env=full, capture_output=True,
                           input=input.encode() if input is not None else None)
    except OSError as e:
        raise GitError(str(e)) from e
    if check and r.returncode != 0:
        lines = [ln for ln in r.stderr.decode(errors="replace").splitlines()
                 if ln.strip() and not ln.startswith(("hint:", "warning:"))]
        raise GitError((lines or [f"git {args[0]} exited {r.returncode}"])[0])
    return r.stdout.decode(errors="surrogateescape")


class Checkout:
    """The git checkout a session ran in, with its working tree snapshotted."""

    def __init__(self, top, gitdir, common, scratch):
        self.top, self.common = top, common
        self.repo = os.path.join(scratch, "snapshot.git")
        self.scratch = scratch
        self.head = git(["rev-parse", "-q", "--verify", "HEAD^{commit}"], top,
                        check=False).strip()
        if not self.head:
            refuse_code(top, "has no commits yet")
        ref = git(["symbolic-ref", "-q", "HEAD"], top, check=False).strip()
        self.branch = ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else ""
        self.linked = os.path.realpath(gitdir) != os.path.realpath(common)
        self.main = (os.path.dirname(common)
                     if self.linked and os.path.basename(common) == ".git" else "")
        self.origin = git(["config", "--get", "remote.origin.url"], top, check=False).strip()
        self.fmt = git(["rev-parse", "--show-object-format"], top, check=False).strip() or "sha1"
        if gitlinks(git(["ls-files", "-s", "-z"], top)):
            refuse_code(top, "has submodules, which this tool does not carry")
        if git(["ls-files", "-z", ":(attr:filter=lfs)"], top).strip("\0"):
            refuse_code(top, "uses Git LFS, which this tool does not carry")
        self.skipped = []
        self.tree, self.wip = self.snapshot(os.path.join(gitdir, "index"))

    def snapshot(self, index):
        git(["init", "-q", "--bare", f"--object-format={self.fmt}", self.repo])
        objects = os.path.join(self.common, "objects")
        with open(os.path.join(self.repo, "objects", "info", "alternates"), "w") as fh:
            fh.write(objects + "\n")
        env = {"GIT_INDEX_FILE": os.path.join(self.scratch, "index"),
               "GIT_OBJECT_DIRECTORY": os.path.join(self.repo, "objects"),
               "GIT_ALTERNATE_OBJECT_DIRECTORIES": objects}
        try:   # a copy of the index keeps its stat cache: only changed files are hashed
            shutil.copyfile(index, env["GIT_INDEX_FILE"])
            git([*SNAPSHOT_OPTS, "add", "-A"], self.top, env)
        except (OSError, GitError):
            git([*SNAPSHOT_OPTS, "read-tree", "HEAD"], self.top, env)
            git([*SNAPSHOT_OPTS, "add", "-A"], self.top, env)
        # `add -A` records a repo nested in the working tree (an untracked clone, a
        # worktree under .claude/worktrees) as a gitlink. It is not this repo's code.
        self.skipped = gitlinks(git(["ls-files", "-s", "-z"], self.top, env))
        if self.skipped:
            git([*SNAPSHOT_OPTS, "update-index", "--force-remove", "--", *self.skipped],
                self.top, env)
        tree = git(["write-tree"], self.top, env).strip()
        wip = git(["commit-tree", tree, "-p", self.head, "-m",
                   "move-claude-session: the working tree"],
                  self.top, {**env, **SNAPSHOT_IDENT}).strip()
        self.git("update-ref", "refs/mcs/wip", wip)
        return tree, wip

    def git(self, *args, input=None, check=True) -> str:
        """git on the snapshot store, which sees the repo's objects too."""
        return git(["--git-dir", self.repo, *args], input=input, check=check)

    def known(self, shas):
        """The commits among these object names (peeled) that exist here."""
        if not shas:
            return []
        out = self.git("cat-file", "--batch-check=%(objectname) %(objecttype)",
                       input="".join(f"{s}^{{commit}}\n" for s in shas))
        return sorted({ln.split()[0] for ln in out.splitlines() if ln.endswith(" commit")})

    def is_ancestor(self, older, newer) -> bool:
        try:
            self.git("merge-base", "--is-ancestor", older, newer)
            return True
        except GitError:
            return False

    def commits(self, negs, limit):
        """(how many commits the host lacks, the newest `limit` as one-liners)."""
        revs = f"{self.head}\n--not\n" + "".join(f"{n}\n" for n in negs)
        count = int(self.git("rev-list", "--count", "--stdin", input=revs).strip())
        log = self.git("log", "--oneline", "--no-decorate", f"-n{limit}", "--stdin",
                       input=revs).splitlines()
        return count, log

    def changes(self):
        """[(status letter, path)] from HEAD to the working tree."""
        out = self.git("diff-tree", "-r", "-z", "--no-renames", "--name-status",
                       self.head, self.wip).split("\0")
        return [(out[i], out[i + 1]) for i in range(0, len(out) - 1, 2)]

    def bundle(self, negs) -> str:
        path = os.path.join(self.scratch, "code.bundle")
        self.git("bundle", "create", "-q", path, "--stdin",
                 input="refs/mcs/wip\n" + "".join(f"^{n}\n" for n in negs))
        return path

    def where(self) -> str:
        return f"{self.branch or 'detached HEAD'} at {self.head[:7]}"


def gitlinks(ls_files_z: str):
    """Paths of the gitlink (submodule) entries in `git ls-files -s -z` output."""
    return [e.split("\t", 1)[1] for e in ls_files_z.split("\0") if e.startswith("160000 ")]


def refuse_code(top: str, why: str) -> "NoReturn":
    die(f"{top} {why}. Check it out on the other machine yourself and pass --no-code. "
        "Nothing changed.")


def local_checkout(cwd: str, scratch: str):
    """The checkout cwd is in, or None when it isn't in one (or there is no git)."""
    if not os.path.isdir(cwd):
        return None
    if not shutil.which("git"):
        print("warning: no git on this machine, so the session's code is not carried",
              file=sys.stderr)
        return None
    try:
        top, gitdir, common = git(["rev-parse", "--path-format=absolute", "--show-toplevel",
                                   "--git-dir", "--git-common-dir"], cwd).splitlines()
    except GitError as e:
        if "not a git repository" in str(e) or "must be run in a work tree" in str(e):
            return None
        die(f"can't read the git checkout in {cwd}: {e}. Nothing changed. "
            "Pass --no-code to move the session without it.")
    try:
        return Checkout(top, gitdir, common, scratch)
    except GitError as e:
        die(f"can't read the git checkout in {top}: {e}. Nothing changed. "
            "Pass --no-code to move the session without it.")


# Shared by the probe and the apply. `dirty` prints the first uncommitted path,
# leaving out repos nested in the working tree. `worktree_tree` hashes the working
# tree the way the snapshot here does, into a temp store, writing nothing.
GIT_SH = r"""export GIT_OPTIONAL_LOCKS=0
tab=$(printf '\t')
dirty() {
  git -C "$1" status --porcelain --untracked-files=all | while IFS= read -r l; do
    p=${l#???}
    case $l in "?? "*/) [ -e "$1/${p}.git" ] && continue ;; esac
    printf '%s\n' "$p"; break
  done
}
worktree_tree() {
  w=$(mktemp -d "${TMPDIR:-/tmp}/mcs.XXXXXX") || return 1
  o=$(cd "$1" && cd "$(git rev-parse --git-common-dir)" && pwd -P)/objects
  mkdir "$w/o"
  (
    export GIT_INDEX_FILE="$w/i" GIT_OBJECT_DIRECTORY="$w/o" GIT_ALTERNATE_OBJECT_DIRECTORIES="$o"
    g() { git -c core.splitIndex=false -c core.fsmonitor=false -c core.untrackedCache=false "$@"; }
    cd "$1" && g read-tree HEAD && g add -A >/dev/null 2>&1 &&
    g ls-files -s | while IFS= read -r l; do
      case $l in 160000*) g update-index --force-remove -- "${l#*"$tab"}" ;; esac
    done && g write-tree
  )
  rm -rf "$w"
}
"""

# What the host has at the checkout's path: MCS-AT top (a checkout of its own
# there), main (no path, but the main repo of the worktree is there), other or
# none, with the facts the plan needs.
CODE_PROBE = r"""top=$1 main=$2 branch=$3
command -v git >/dev/null 2>&1 || { echo MCS-NOGIT; exit 0; }
is_top() {
  [ -d "$1" ] && t=$(git -C "$1" rev-parse --show-toplevel 2>/dev/null) &&
    [ "$(cd "$t" && pwd -P)" = "$(cd "$1" && pwd -P)" ]
}
facts() {
  git -C "$1" for-each-ref --format='MCS-REF %(objectname)'
  printf 'MCS-HEAD %s\n' "$(git -C "$1" rev-parse -q --verify 'HEAD^{commit}')"
  printf 'MCS-CURRENT %s\n' "$(git -C "$1" symbolic-ref -q HEAD)"
  [ -z "$branch" ] || printf 'MCS-BRANCH %s\n' "$(git -C "$1" rev-parse -q --verify "refs/heads/$branch")"
  printf 'MCS-ORIGIN %s\n' "$(git -C "$1" config --get remote.origin.url)"
}
if is_top "$top"; then
  echo MCS-AT top
  facts "$top"
  p=$(dirty "$top")
  if [ -z "$p" ]; then
    printf 'MCS-WTREE %s\n' "$(git -C "$top" rev-parse -q --verify 'HEAD^{tree}')"
  else
    printf 'MCS-DIRTY %s\n' "$p"
    printf 'MCS-WTREE %s\n' "$(worktree_tree "$top")"
  fi
elif [ -e "$top" ] || [ -L "$top" ]; then
  echo MCS-AT other
elif [ -n "$main" ] && is_top "$main"; then
  echo MCS-AT main
  facts "$main"
else
  echo MCS-AT none
fi
echo MCS-OK"""

# stdin: the bundle. Checks it arrived whole, then (mode) fetches into the checkout
# at $top, adds a worktree of $main at $top, or makes a new repo at $top; checks
# out HEAD, restores the snapshot over the working tree and checks the result.
# Any failure after the first change puts the host back as it was, the stash it
# made with --force included. Ignores HUP and PIPE, so a dropped connection can't
# stop it halfway.
CODE_APPLY = r"""top=$1 mode=$2 main=$3 branch=$4 head=$5 wip=$6 force=$7 stash=$8 origin=$9 fmt=${10} want=${11}
trap '' HUP PIPE
tmp=$(mktemp -d "${TMPDIR:-/tmp}/mcs.XXXXXX") || { echo 'MCS-FAIL could not make a temp dir'; exit 1; }
trap 'rm -rf "$tmp"' EXIT
b=$tmp/code.bundle laid="" stashed="" bsha=""
fail() { printf 'MCS-FAIL %s\n' "$1"; exit 1; }
stuck() { printf 'MCS-STUCK %s\n' "$1"; exit 1; }
err() { sed -e '/^hint:/d' -e '/^warning:/d' -e '/^[[:space:]]*$/d' "$tmp/err" | head -n 1; }
run() { "$@" >/dev/null 2>"$tmp/err"; }
cat > "$b"
if command -v shasum >/dev/null 2>&1; then got=$(shasum -a 256 < "$b" | cut -c1-64)
elif command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum < "$b" | cut -c1-64)
else fail "no shasum or sha256sum to check the code with"; fi
[ "$got" = "$want" ] || fail "the code did not arrive intact"
ident() {
  [ -n "$(git -C "$1" config user.name)" ] ||
    export GIT_AUTHOR_NAME=move-claude-session GIT_COMMITTER_NAME=move-claude-session
  [ -n "$(git -C "$1" config user.email)" ] ||
    export GIT_AUTHOR_EMAIL=move-claude-session@localhost GIT_COMMITTER_EMAIL=move-claude-session@localhost
}
fetch() {
  run git -C "$1" fetch -q --no-tags --no-write-fetch-head "$b" refs/mcs/wip || return 1
  [ -n "$branch" ] || return 0
  bsha=$(git -C "$1" rev-parse -q --verify "refs/heads/$branch")
  if [ -n "$bsha" ] && [ "$bsha" != "$head" ] && ! git -C "$1" merge-base --is-ancestor "$bsha" "$head"; then
    fail "$branch has commits on the host that it lacks here"
  fi
}
checkout() {
  if [ -n "$branch" ]; then run git -C "$1" checkout -q -B "$branch" "$head"
  else run git -C "$1" checkout -q --detach "$head"; fi
}
verify() {
  [ "$(git -C "$1" rev-parse -q --verify HEAD)" = "$head" ] || return 1
  [ "$(git -C "$1" symbolic-ref -q HEAD)" = "${branch:+refs/heads/$branch}" ] || return 1
  GIT_INDEX_FILE="$tmp/verify" git -C "$1" read-tree "$wip" || return 1
  GIT_INDEX_FILE="$tmp/verify" git -C "$1" update-index -q --refresh >/dev/null
  GIT_INDEX_FILE="$tmp/verify" git -C "$1" diff-files --quiet
}
lay() {
  laid=1
  run git -C "$1" restore -q --source="$wip" --worktree -- :/ || return 1
  verify "$1" || { echo "the working tree did not come out as it is here" > "$tmp/err"; return 1; }
}
unlay() {
  [ -n "$laid" ] || return 0
  (cd "$1" && git diff --name-only -z --no-renames --diff-filter=A "$head" "$wip" | xargs -0 rm -f --)
}
undo_top() {
  why=$1 bad=""
  if [ -n "$branch" ] && [ -n "$bsha" ]; then git -C "$top" update-ref "refs/heads/$branch" "$bsha" || bad=1; fi
  if [ -n "$oref" ]; then git -C "$top" checkout -q -f "${oref#refs/heads/}" -- >/dev/null 2>&1 || bad=1
  elif [ -n "$orig" ]; then git -C "$top" checkout -q -f --detach "$orig" >/dev/null 2>&1 || bad=1; fi
  if [ -n "$branch" ] && [ -z "$bsha" ] && [ "refs/heads/$branch" != "$oref" ]; then
    git -C "$top" branch -q -D "$branch" >/dev/null 2>&1 || bad=1
  fi
  unlay "$top" || bad=1
  if [ -n "$stashed" ]; then
    git -C "$top" stash pop -q --index >/dev/null 2>&1 || git -C "$top" stash pop -q >/dev/null 2>&1 || bad=1
  fi
  note=""
  [ -z "$stashed" ] || note="; its own changes are in the stash \"$stash\""
  [ -z "$bad" ] || stuck "$why, and could not put $top back as it was$note"
  fail "$why"
}
undo_new() {
  why=$1
  if [ "$mode" = worktree ]; then
    git -C "$main" worktree remove -f -f "$top" >/dev/null 2>&1 || rm -rf "$top"
    git -C "$main" worktree prune >/dev/null 2>&1
    if [ -n "$branch" ] && [ -n "$bsha" ]; then
      git -C "$main" update-ref "refs/heads/$branch" "$bsha" || stuck "$why, and could not put $branch back at $bsha"
    elif [ -n "$branch" ] && git -C "$main" rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
      git -C "$main" branch -q -D "$branch" >/dev/null 2>&1 || stuck "$why, and could not delete the branch $branch it made"
    fi
  else
    rm -rf "$top"
  fi
  [ -z "$made" ] || rm -rf "$made"
  [ ! -e "$top" ] || stuck "$why, and could not remove $top"
  fail "$why"
}
case $mode in
top)
  ident "$top"
  fetch "$top" || fail "could not fetch the code into $top: $(err)"
  p=$(dirty "$top")
  [ -z "$p" ] || [ "$force" = 1 ] || fail "$top has uncommitted changes ($p)"
  # A file the snapshot adds that the host has as an ignored file would be
  # overwritten, and no stash holds it. Refuse rather than lose it.
  ign=$(cd "$top" && git diff --name-only -z --no-renames --diff-filter=A "$head" "$wip" |
    xargs -0 sh -c 'for p; do { [ -e "$p" ] || [ -L "$p" ]; } && git check-ignore -q -- "$p" && { printf "%s\n" "$p"; break; }; done' sh)
  [ -z "$ign" ] || fail "$top/$ign exists on the host as an ignored file, and the move would overwrite it"
  oref=$(git -C "$top" symbolic-ref -q HEAD) orig=$(git -C "$top" rev-parse -q --verify HEAD)
  if [ -n "$p" ]; then
    run git -C "$top" stash push -q -u -m "$stash" || fail "could not stash the changes in $top: $(err)"
    stashed=1
    printf 'MCS-STASHED %s\n' "$stash"
  fi
  { checkout "$top" && lay "$top"; } || undo_top "$(err)"
  ;;
worktree|clone)
  { [ ! -e "$top" ] && [ ! -L "$top" ]; } || fail "$top appeared on the host since the check"
  made="" d=$(dirname "$top")
  while [ ! -e "$d" ]; do made=$d d=$(dirname "$d"); done
  mkdir -p "$(dirname "$top")" || fail "could not create $(dirname "$top")"
  if [ "$mode" = worktree ]; then
    ident "$main"
    fetch "$main" || fail "could not fetch the code into $main: $(err)"
    if [ -n "$branch" ]; then run git -C "$main" worktree add -q -B "$branch" "$top" "$head"
    else run git -C "$main" worktree add -q --detach "$top" "$head"; fi || undo_new "could not add a worktree at $top: $(err)"
  else
    run git init -q --object-format="$fmt" "$top" || undo_new "could not make a repo at $top: $(err)"
    { fetch "$top" && checkout "$top" &&
      { [ -z "$origin" ] || run git -C "$top" remote add origin "$origin"; }; } || undo_new "$(err)"
  fi
  lay "$top" || undo_new "$(err)"
  ;;
*) fail "unknown mode $mode" ;;
esac
echo MCS-CODE-DONE"""


def plan_code(host: str, co: Checkout, force: bool) -> dict:
    """How the checkout gets to host, from what the host has: a dict whose mode is
    'same' (nothing to carry), 'top', 'worktree' or 'clone'. Dies on what it must
    refuse, before anything is sent."""
    code, lines, err = ssh_run(host, GIT_SH + CODE_PROBE, [co.top, co.main, co.branch])
    if code != 0 or not {"MCS-OK", "MCS-NOGIT"} & set(lines):
        die(f"can't check the code on {host}: {err}. Nothing changed.")
    if "MCS-NOGIT" in lines:
        die(f"{host} has no git, so the code in {co.top} can't go there. "
            "Pass --no-code to move the session without it. Nothing changed.")
    facts, refs = {}, []
    for ln in lines:
        key, _, val = ln.partition(" ")
        if key == "MCS-REF":
            refs.append(val)
        else:
            facts[key] = val
    at = facts.get("MCS-AT")
    plan = {"mode": "clone", "negs": [], "bsha": "", "dirty": "", "force": force}
    if at == "other":
        die(f"{co.top} exists on {host} and is not a checkout of this repo. Move it aside "
            "there, or pass --no-code. Nothing changed.")
    if at == "none":
        if co.linked:
            die(f"{co.top} is a worktree of {co.main or 'a repo'}, which is not on {host}. "
                "Clone it there first, or pass --no-code. Nothing changed.")
        return plan
    there = co.top if at == "top" else co.main
    plan["negs"] = co.known(refs)
    if not plan["negs"] and not (co.origin and facts.get("MCS-ORIGIN") == co.origin):
        die(f"{there} on {host} is a different repo: it shares no commits or origin with "
            f"{co.top}. Nothing changed.")
    plan["bsha"] = bsha = facts.get("MCS-BRANCH", "")
    if co.branch and bsha and bsha != co.head and not co.is_ancestor(bsha, co.head):
        die(f"{co.branch} on {host} has commits that it lacks here, so it can't be moved "
            f"to {co.head[:7]} without losing them. Merge or push them first, or pass "
            "--no-code. Nothing changed.")
    if at == "main":
        plan["mode"] = "worktree"
        return plan
    current = f"refs/heads/{co.branch}" if co.branch else ""
    if (facts.get("MCS-HEAD") == co.head and facts.get("MCS-CURRENT") == current
            and facts.get("MCS-WTREE") == co.tree):
        plan["mode"] = "same"
        return plan
    plan["mode"], plan["dirty"] = "top", facts.get("MCS-DIRTY", "")
    if plan["dirty"] and not force:
        die(f"{co.top} on {host} has uncommitted changes ({plan['dirty']}). Commit them "
            "there, or pass --force to stash them there first. Nothing changed.")
    return plan


def code_summary(host: str, co: Checkout, plan: dict) -> str:
    how = {"same": "is already there, with the same changes",
           "clone": f"is not on {host}: a new repo is made there"
                    + (f", origin {co.origin}" if co.origin else ""),
           "worktree": f"is not on {host}: it is added as a worktree of {co.main}"}
    if plan["mode"] in how:
        return how[plan["mode"]]
    if not co.branch:
        return f"is checked out there detached at {co.head[:7]}"
    if not plan["bsha"]:
        return f"is checked out there on a new branch {co.branch}"
    if plan["bsha"] != co.head:
        return f"is checked out there, fast-forwarding {co.branch} from {plan['bsha'][:7]}"
    return f"is checked out there on {co.branch}"


def print_code_plan(host: str, co: Checkout, plan: dict) -> None:
    print(f"\nwould carry the code in {co.top} ({co.where()}). It {code_summary(host, co, plan)}.")
    if plan["mode"] == "same":
        return
    if plan["dirty"]:
        print(f"Its uncommitted changes there are stashed first ({plan['dirty']}, ...).")
    count, log = co.commits(plan["negs"], 10)
    print(f"  {count} commit{'s' * (count != 1)} to send")
    for line in log:
        print(f"    {line}")
    if count > len(log):
        print(f"    ... and {count - len(log)} more")
    changes = co.changes()
    print(f"  {len(changes)} changed file{'s' * (len(changes) != 1)}")
    for status, path in changes[:30]:
        print(f"    {status}  {path}")
    if len(changes) > 30:
        print(f"    ... and {len(changes) - 30} more")
    for path in co.skipped:
        print(f"  skipped {path}: a repo of its own")


def carry_code(host: str, co: Checkout, plan: dict, session_id: str) -> None:
    """Send the checkout to host and lay it out there, or die with the session
    untouched here."""
    for path in co.skipped:
        print(f"skipped {path}: a repo of its own, not carried")
    if plan["mode"] == "same":
        print(f"code: {co.top} ({co.where()}) is already on {host}")
        return
    bundle = co.bundle(plan["negs"])
    digest = hashlib.sha256()
    with open(bundle, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            digest.update(chunk)
    digest = digest.hexdigest()
    stash = f"move-claude-session {session_id} {time.strftime('%Y-%m-%d %H:%M')}"

    def feed(fh):
        with open(bundle, "rb") as src:
            shutil.copyfileobj(src, fh)
    try:
        code, lines, err = ssh_run(host, GIT_SH + CODE_APPLY,
                                   [co.top, plan["mode"], co.main, co.branch, co.head, co.wip,
                                    "1" if plan["force"] else "0", stash, co.origin, co.fmt,
                                    digest], feed=feed, timeout=None)
    except KeyboardInterrupt:
        lines, err = [], "interrupted"
    if "MCS-CODE-DONE" not in lines:
        failed = next((ln[len("MCS-FAIL "):] for ln in lines if ln.startswith("MCS-FAIL ")), None)
        if failed:
            die(f"carrying the code to {host} failed, nothing changed: {failed}")
        stuck = next((ln[len("MCS-STUCK "):] for ln in lines if ln.startswith("MCS-STUCK ")), None)
        if stuck:
            die(f"carrying the code to {host} failed: {stuck}. The session was not moved.")
        die(f"could not confirm the code reached {host} ({err}). The session was not moved. "
            f"On {host} the checkout either finished or was put back: run the same move again.")
    if any(ln.startswith("MCS-STASHED ") for ln in lines):
        print(f"stashed the uncommitted changes in {co.top} on {host} as \"{stash}\"")
    count = co.commits(plan["negs"], 0)[0]
    files = len(co.changes())
    print(f"carried the code to {host}: {co.where()}, {count} commit{'s' * (count != 1)}, "
          f"{files} changed file{'s' * (files != 1)}")


def remote_is_here(preflight_lines, src_root: str) -> bool:
    """Whether the remote account dir is this machine's source account dir (same
    real path and inode), as when an ssh alias points back at this machine."""
    line = next((ln for ln in preflight_lines if ln.startswith("MCS-ROOT ")), "")
    ino, _, path = line[len("MCS-ROOT "):].partition(" ")
    st = os.stat(src_root)
    return path == os.path.realpath(src_root) and ino == str(st.st_ino)


def same_inode(path: str, ino: int) -> bool:
    try:
        return os.lstat(path).st_ino == ino
    except OSError:
        return False


def remote_resume(dest, session_id: str, cwd: str) -> str:
    """The shell command that resumes the session on its host, from its project."""
    _, account, root = dest
    env = ("env -u CLAUDE_CONFIG_DIR " if account == DEFAULT_ACCOUNT
           else f"env CLAUDE_CONFIG_DIR={shlex.quote(root)} ")
    return f"cd {shlex.quote(cwd)} && {env}claude --resume {shlex.quote(session_id)}"


def login_shell(command: str) -> str:
    """`command` run by a login, interactive shell, so PATH is what a terminal on
    the host gets. A bare ssh command runs with a minimal PATH."""
    inner = f'"{command}"' if not re.search(r'["$`\\!]', command) else shlex.quote(command)
    return f'exec "$SHELL" -lic {inner}'


def ssh_t_text(host: str, command: str) -> str:
    return f"ssh -t {host} {shlex.quote(login_shell(command))}"


def resume_remote(dest, session_id: str, title: str, cwd: str, dir_ok: bool) -> int:
    """Open the moved session on its host: a cmux ssh workspace inside cmux, else
    ssh -t in this terminal. A missing project dir there is said, not resumed."""
    host, account, _ = dest
    command = remote_resume(dest, session_id, cwd)
    if not dir_ok:
        print(f"\n{cwd} does not exist on {host}, so the session was not resumed there.\n"
              f"Check the project out on {host}, then run:\n  {ssh_t_text(host, command)}")
        return 0
    print(f"\nresuming as {account} on {host} in {short_path(cwd)}\n  {command}\n", flush=True)
    try:
        if os.environ.get("CMUX_SURFACE_ID") and shutil.which("cmux"):
            os.execvp("cmux", ["cmux", "ssh", host, "--name", title[:40] or session_id[:8],
                               "--command", command])
        os.execvp("ssh", ["ssh", "-t", "-o", "ConnectTimeout=10", "--", host,
                          login_shell(command)])
    except OSError as e:
        die(f"moved, but could not open it on {host}: {e}")


# ---------------------------------------------------------------- picker data

def last_record(buf, rtype: str):
    """The last JSON line of type `rtype` in the transcript buffer, or None."""
    at = buf.rfind(f'"type":"{rtype}"'.encode())
    if at < 0:
        return None
    start = buf.rfind(b"\n", 0, at) + 1
    end = buf.find(b"\n", at)
    try:
        rec = json.loads(buf[start:end if end >= 0 else len(buf)])
    except ValueError:
        return None
    return rec if isinstance(rec, dict) else None


def first_prompt(buf):
    """(cwd, first thing typed) from the head of the transcript."""
    cwd = prompt = ""
    for raw in buf[:PROMPT_SCAN_BYTES].splitlines():
        try:
            rec = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(rec, dict):
            continue
        cwd = cwd or rec.get("cwd") or ""
        if rec.get("type") == "user" and not rec.get("isMeta"):
            text = prompt_text((rec.get("message") or {}).get("content"))
            if text and text not in UNINFORMATIVE_PROMPTS:
                return cwd, text
    return cwd, prompt


def read_label(path: str):
    """(cwd, title) for display. The title is the one Claude Code shows on the tab:
    a /rename title, else its generated ai-title, else the first typed prompt."""
    try:
        with open(path, "rb") as fh, mmap.mmap(fh.fileno(), 0, access=mmap.ACCESS_READ) as buf:
            custom = last_record(buf, "custom-title") or {}
            ai = last_record(buf, "ai-title") or {}
            cwd, prompt = first_prompt(buf)
    except (OSError, ValueError):   # ValueError: mmap of an empty file
        return "", ""
    title = custom.get("customTitle") or ai.get("aiTitle") or prompt
    return cwd, " ".join(str(title).split())


UNINFORMATIVE_PROMPTS = {"/clear", "/compact", "/resume", "/model", "/config",
                         "/login", "/status", "/cost", "/exit"}
COMMAND_RE = re.compile(r"<command-name>(.*?)</command-name>", re.S)
ARGS_RE = re.compile(r"<command-args>(.*?)</command-args>", re.S)


def prompt_text(content) -> str:
    """What the user typed: plain text, or `/command args` for a slash command.
    Tool results and injected <system-reminder> style blocks return ''."""
    if isinstance(content, list):
        texts = [b.get("text", "") for b in content
                 if isinstance(b, dict) and b.get("type") == "text"]
        return next((t for t in map(prompt_text, texts) if t), "")
    if not isinstance(content, str):
        return ""
    cmd = COMMAND_RE.search(content)
    if cmd:
        args = ARGS_RE.search(content)
        return f"{cmd.group(1).strip()} {args.group(1).strip() if args else ''}".strip()
    return "" if content.lstrip().startswith("<") else content


def cache_path() -> str:
    base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "move-claude-session", "labels.json")


def cached_labels(paths):
    """{path: (cwd, title)}. Labels are cached per transcript and keyed on its size
    and mtime, so any write to a transcript (quitting a session included) refreshes
    its entry. Reading titles from scratch costs about 0.3 s over 400 MB."""
    try:
        with open(cache_path(), encoding="utf-8") as fh:
            cache = json.load(fh)
        if not isinstance(cache, dict):
            cache = {}
    except (OSError, ValueError):
        cache = {}
    out, fresh, dirty = {}, {}, False
    for path in paths:
        try:
            st = os.stat(path)
        except OSError:
            continue
        key = [st.st_size, st.st_mtime_ns]
        hit = cache.get(path)
        if isinstance(hit, list) and len(hit) == 4 and hit[:2] == key:
            label = (hit[2], hit[3])
        else:
            label, dirty = read_label(path), True
        out[path] = label
        fresh[path] = key + list(label)
    # Keep other folders' entries too, so changing directory doesn't evict them.
    # Entries leave the cache when their transcript is gone (moved or deleted).
    gone = [p for p in cache if p not in fresh and not os.path.exists(p)]
    if dirty or gone:
        kept = {p: v for p, v in cache.items() if p not in fresh and p not in gone}
        save_cache({**kept, **fresh})
    return out


def last_path(what: str) -> str:
    return os.path.join(os.path.dirname(cache_path()), f"last-{what}")


def last_choice(what: str) -> str:
    """The account ("target") or machine ("host") moved to last time."""
    try:
        with open(last_path(what), encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def save_last(account: str, host: str) -> None:
    try:
        os.makedirs(os.path.dirname(last_path("target")), exist_ok=True)
        for what, value in (("target", account), ("host", host)):
            with open(last_path(what), "w", encoding="utf-8") as fh:
                fh.write(value + "\n")
    except OSError:
        pass   # only a convenience


def save_cache(entries) -> None:
    path = cache_path()
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        tmp = f"{path}.{os.getpid()}.tmp"
        with open(tmp, "w", encoding="utf-8") as fh:
            json.dump(entries, fh)
        os.replace(tmp, path)
    except OSError:
        pass   # the cache only saves time


def cmux_sessions():
    try:
        with open(os.path.expanduser(CMUX_HOOK_SESSIONS), encoding="utf-8") as fh:
            sessions = json.load(fh).get("sessions") or {}
    except (OSError, ValueError, AttributeError):
        return {}
    return sessions if isinstance(sessions, dict) else {}


def project_folder(cwd: str) -> str:
    """Claude Code's projects/ folder name for a working directory, before the
    truncation folder_matches() allows for."""
    return re.sub(r"[^A-Za-z0-9]", "-", cwd)


def folder_matches(folder: str, cwd: str) -> bool:
    """Whether a projects/ folder belongs to this working directory. Names over 200
    characters are cut to 200 and get a hash of the full path appended."""
    name = project_folder(cwd)
    return folder == name if len(name) <= 200 else folder.startswith(name[:200])


def group_of(sid: str, path: str, terminal, here) -> int:
    if sid in terminal:
        return 0
    folder = os.path.basename(os.path.dirname(path))
    if any(folder_matches(folder, d) for d in here):
        return 1
    return 2


def current_dirs():
    """The current directory as the shell spells it ($PWD, which may run through a
    symlink), then resolved. $PWD counts only when it still points here."""
    real = os.getcwd()
    pwd = os.environ.get("PWD")
    return [pwd, real] if pwd and pwd != real and os.path.realpath(pwd) == real else [real]


def candidates(force: bool = False):
    """Picker rows, grouped and newest first within each group (see GROUPS)."""
    surface = os.environ.get("CMUX_SURFACE_ID")
    terminal = {sid for sid, rec in cmux_sessions().items()
                if surface and isinstance(rec, dict) and rec.get("surfaceId") == surface}
    here = current_dirs()
    picked, seen = [[] for _ in GROUPS], set()
    for t in sorted(all_transcripts(), key=lambda t: -t[3]):
        account, sid, path, mtime = t
        if sid in seen:
            continue
        seen.add(sid)
        group = group_of(sid, path, terminal, here)
        if len(picked[group]) < GROUPS[group][1]:
            picked[group].append(t)
    flat = [(g, t) for g, ts in enumerate(picked) for t in ts]
    labels = cached_labels([t[2] for _, t in flat])
    live = running_sessions(force)
    rows = []
    for group, (account, sid, path, mtime) in flat:
        cwd_, title = labels.get(path, ("", ""))
        rows.append({"id": sid, "account": account, "path": path, "mtime": mtime,
                     "cwd": cwd_, "title": title, "group": group, "live": live.get(sid)})
    return rows


def age(mtime: float) -> str:
    secs = max(0, time.time() - mtime)
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if secs >= size:
            return f"{int(secs // size)}{unit}"
    return f"{int(secs)}s"


def short_path(p: str) -> str:
    home = os.path.expanduser("~")
    return "~" + p[len(home):] if p == home or p.startswith(home + "/") else p


def row_segments(r):
    """One picker row as (text, role) pieces; the roles map to colors in pick()."""
    state = "running" if r["live"] else age(r["mtime"])
    cwd = short_path(r["cwd"])
    if len(cwd) > 30:
        cwd = "…" + cwd[-29:]
    return [(f"  {state:>7}  ", "live" if r["live"] else "age"),
            (f"{r['account']:<9}", account_role(r["account"])),
            (f"{cwd:<30}  ", "cwd"),
            (r["title"] or r["id"], "title" if r["title"] else "dim")]


def account_role(name: str) -> str:
    return f"acct{list(accounts()).index(name) % 4}"


def row_text(r) -> str:
    return "".join(t for t, _ in row_segments(r))


# ---------------------------------------------------------------- picker UI

# role: (foreground, bold). -1 is the terminal's default color.
PALETTE = {
    "header": (6, True), "prompt": (5, True), "count": (8, False), "section": (5, True),
    "age": (2, False), "live": (1, True),
    "acct0": (4, True), "acct1": (3, True), "acct2": (5, True), "acct3": (2, True),
    "cwd": (6, False), "title": (-1, False), "dim": (8, False), "hint": (8, False),
}


def init_colors():
    """{role: attr} for normal rows. The selected row is drawn in reverse video
    instead, which keeps full contrast in any theme."""
    import curses
    color = curses.has_colors()
    if color:
        curses.start_color()
        curses.use_default_colors()
    many = color and curses.COLORS >= 16
    attrs = {}
    for n, (role, (fg, bold)) in enumerate(PALETTE.items(), start=1):
        base = curses.A_BOLD if bold else 0
        if not color:
            attrs[role] = base
            continue
        curses.init_pair(n, -1 if fg == 8 and not many else fg, -1)
        attrs[role] = curses.color_pair(n) | base
    return attrs


def layout(shown, sections):
    """Screen lines for the filtered rows: ("section", title) or ("row", index)."""
    lines, last = [], None
    for i in shown:
        if sections[i] and sections[i] != last:
            lines.append(("section", sections[i]))
        last = sections[i]
        lines.append(("row", i))
    return lines


def scroll(top: int, line: int, body: int, lines) -> int:
    """New top line that keeps `line` on screen, with its section title when it
    is the first row of a section."""
    first = line - 1 if line > 0 and lines[line - 1][0] == "section" else line
    if first < top:
        return first
    if line >= top + body:
        return line - body + 1
    return top


def pick(header: str, rows, disabled=frozenset(), sections=None, start=0):
    """Arrow-key list with type-to-filter over rows of (text, role) segments,
    optionally under section titles, starting on row `start`. Returns the chosen
    index or None."""
    import curses
    os.environ.setdefault("ESCDELAY", "25")
    plain = ["".join(t for t, _ in segs) for segs in rows]
    sections = sections or [None] * len(rows)

    def put(scr, y, x, text, n, attr):
        try:
            scr.addnstr(y, x, text, n, attr)
        except curses.error:   # wide characters can run past the last column
            pass

    def draw_row(scr, y, w, segs, attr_of):
        x = 0
        for text, role in segs:
            if x >= w - 1:
                break
            put(scr, y, x, text, w - 1 - x, attr_of(role))
            x += len(text)
        return x

    def ui(scr):
        curses.curs_set(0)
        attrs = init_colors()
        selected = curses.A_REVERSE | curses.A_BOLD
        query, top = "", 0
        cur = next((i for i in [start, *range(len(rows))] if i not in disabled), 0)
        while True:
            words = query.lower().split()
            shown = [i for i, s in enumerate(plain)
                     if all(wd in s.lower() for wd in words)]
            cur = min(cur, max(0, len(shown) - 1))
            lines = layout(shown, sections)
            h, w = scr.getmaxyx()
            body = max(1, h - 4)
            line = lines.index(("row", shown[cur])) if shown else 0
            top = scroll(top, line, body, lines) if shown else 0
            scr.erase()
            put(scr, 0, 0, header, w - 1, attrs["header"])
            draw_row(scr, 1, w, [("❯ ", "prompt"), (query, "title"),
                                 (f"  {len(shown)}/{len(rows)}", "count")], attrs.get)
            for y, (kind, val) in enumerate(lines[top:top + body], start=3):
                if kind == "section":
                    put(scr, y, 0, f"── {val} " + "─" * w, w - 1, attrs["section"])
                elif shown and val == shown[cur]:
                    x = draw_row(scr, y, w, rows[val], lambda _r: selected)
                    put(scr, y, x, " " * w, w - 1 - x, selected)
                elif val in disabled:
                    draw_row(scr, y, w, rows[val], lambda _r: attrs["dim"] | curses.A_DIM)
                else:
                    draw_row(scr, y, w, rows[val], attrs.get)
            hint = "↑↓ move · enter pick · esc cancel · type to filter"
            if disabled:
                hint += " · running sessions can't move"
            put(scr, h - 1, 0, hint, w - 1, attrs["hint"])
            scr.refresh()

            key = scr.get_wch()
            if key in ("\n", "\r", curses.KEY_ENTER):
                if shown and shown[cur] not in disabled:
                    return shown[cur]
                curses.beep()
            elif key in ("\x1b", "\x03"):
                return None
            elif key in (curses.KEY_UP, "\x10"):
                cur = max(0, cur - 1)
            elif key in (curses.KEY_DOWN, "\x0e"):
                cur = min(len(shown) - 1, cur + 1)
            elif key in (curses.KEY_BACKSPACE, "\x7f", "\b"):
                query, cur = query[:-1], 0
            elif isinstance(key, str) and key.isprintable():
                query, cur = query + key, 0

    try:
        return curses.wrapper(ui)
    except KeyboardInterrupt:
        return None


def pick_account(header: str, targets, rows):
    """Ask which account to move to, starting on the last one moved to."""
    last = last_choice("target")
    j = pick(header, rows, start=targets.index(last) if last in targets else 0)
    return None if j is None else targets[j]


def choose_machine():
    """LOCAL or a configured host. With no hosts configured there is no step."""
    hosts = configured_hosts()
    if not hosts:
        return LOCAL
    machines = ([LOCAL] if len(accounts()) > 1 else []) + hosts
    if len(machines) == 1:
        return machines[0]
    last = last_choice("host")
    j = pick("Move to which machine?",
             [[(f"{m:<10}", f"acct{n % 4}"), ("this machine" if m == LOCAL else "over ssh", "cwd")]
              for n, m in enumerate(machines)],
             start=machines.index(last) if last in machines else 0)
    return None if j is None else machines[j]


def interactive_remote(row, host: str, dry: bool, force: bool, carry: bool) -> int:
    home, found = remote_accounts(host)
    targets = list(found)
    rows = [[(f"{a:<10}", f"acct{n % 4}"),
             ("~" + root[len(home):] if root.startswith(home + "/") else root, "cwd"),
             *([] if has_projects else [("  no sessions yet", "dim")])]
            for n, (a, (root, has_projects)) in enumerate(found.items())]
    target = targets[0] if len(targets) == 1 else pick_account(
        f"Move to which account on {host}?  (now in {row['account']} on this machine)",
        targets, rows)
    if target is None:
        return 1
    dest = remote_dest(host, target)
    moved = move_session(row["id"], target, dry, force, dest, carry)
    if moved is None:
        return 0
    return resume_remote(dest, row["id"], row["title"], *moved)


def interactive(dry: bool, force: bool, carry: bool) -> int:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        die("the picker needs a terminal. Pass <session_id> <account> instead.")
    rows = candidates(force)
    if not rows:
        die("no sessions found in any account")
    disabled = frozenset(i for i, r in enumerate(rows) if r["live"])
    here = short_path(current_dirs()[0])
    titles = [GROUPS[0][0], f"{GROUPS[1][0]} ({here})", GROUPS[2][0]]
    i = pick("Move which session?", [row_segments(r) for r in rows], disabled,
             [titles[r["group"]] for r in rows])
    if i is None:
        return 1
    row = rows[i]
    machine = choose_machine()
    if machine is None:
        return 1
    if machine != LOCAL:
        return interactive_remote(row, machine, dry, force, carry)
    targets = [a for a in accounts() if a != row["account"]]
    if not targets:
        die("only one Claude Code account found, nowhere to move to")
    target = targets[0] if len(targets) == 1 else pick_account(
        f"Move to which account?  (now in {row['account']})", targets,
        [[(f"{a:<10}", account_role(a)), (short_path(account_root(a)), "cwd")] for a in targets])
    if target is None:
        return 1

    cwd = move_session(row["id"], target, dry, force)
    if cwd is None:
        return 0
    if os.path.isdir(cwd):
        os.chdir(cwd)
    else:
        print(f"warning: {cwd} no longer exists, resuming from {os.getcwd()}",
              file=sys.stderr)
        cwd = os.getcwd()
    print(f"\nresuming as {target} in {short_path(cwd)}\n", flush=True)
    try:
        os.execvpe("claude", ["claude", "--resume", row["id"]], launch_env(target))
    except OSError as e:
        die(f"moved, but could not launch claude: {e}")


def print_list() -> int:
    for r in candidates():
        print(f"{r['id']}  {GROUPS[r['group']][0]:<16}{row_text(r)}")
    return 0


def main(argv):
    args = []
    dry = force = listing = False
    carry = True
    for a in argv:
        if a in ("-h", "--help"):
            print(__doc__)
            return 0
        elif a in ("-n", "--dry-run"):
            dry = True
        elif a == "--force":
            force = True
        elif a == "--list":
            listing = True
        elif a == "--no-code":
            carry = False
        elif a.startswith("-"):
            die(f"unknown option: {a}")
        else:
            args.append(a)

    if listing:
        return print_list()
    if not args:
        return interactive(dry, force, carry)
    if len(args) != 2:
        die("usage: move-claude-session [<session_id> <account>[@<host>]]. Try --help.")
    session_id, target = args
    if target not in accounts():
        account, _, host = target.partition("@")
        if host and host != LOCAL:
            return move_to_host(session_id, account, check_host(host), dry, force, carry)
        target = account
    if target not in accounts():
        die(f"unknown account: {target} (one of {', '.join(accounts())})")

    cwd = move_session(session_id, target, dry, force)
    if cwd is not None:
        print(f"\ndone. resume with:  cd {shlex.quote(cwd)}; {resume_command(target, session_id)}")
    return 0



def move_to_host(session_id: str, account: str, host: str, dry: bool, force: bool,
                 carry: bool) -> int:
    dest = remote_dest(host, account)
    moved = move_session(session_id, account, dry, force, dest, carry)
    if moved is not None:
        cwd, dir_ok = moved
        print(f"\ndone. resume with:  {ssh_t_text(host, remote_resume(dest, session_id, cwd))}")
        if not dir_ok:
            print(f"note: {cwd} does not exist on {host}. Check the project out there first.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
